{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "outputDirectory": ".",
  "trailingSlash": false,
  "headers": [
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, stale-while-revalidate=600"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ],
  "functions": {
    "api/cron/ingest.py": {
      "maxDuration": 60,
      "memory": 1024,
      "excludeFiles": "{data,reports,assets,legacy,classic,docs,tests,src,samples,examples,feeds,personas,skills,supabase,node_modules,dist}/**"
    },
    "api/source-health.py": {
      "maxDuration": 10,
      "excludeFiles": "{data,reports,assets,legacy,classic,docs,tests,src,samples,examples,feeds,personas,skills,supabase,node_modules,dist}/**"
    }
  },
  "redirects": [
    {
      "source": "/scripts/:path*",
      "destination": "/",
      "permanent": false
    }
  ]
}
