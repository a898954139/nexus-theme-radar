{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd front && npm ci",
  "buildCommand": "cd front && npm run build && sh copy_reports.sh dist",
  "outputDirectory": "front/dist",
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://nexus-theme-radar-api.vercel.app/api/:path*"
    }
  ],
  "redirects": [
    {
      "source": "/scripts/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/data/:path*",
      "destination": "/",
      "permanent": false
    }
  ]
}
