{
  "_doc": "Canonical DB roles and connection facts (M009, M010, M011). Quote role names and hosts from here, never from memory. lint/repo_lint.py checks every role name and connection string in the repo against this file.",
  "project": {
    "ref": "xdixmdglgzaiugvfxmuw",
    "retired_refs": [
      "abtdxucfppnjdqkwqiqh"
